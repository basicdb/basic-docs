#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
export MINTLIFY_TELEMETRY_DISABLED=1
node_version="$(<.node-version)"
mint_version=4.2.940

echo "Preparing Node.js ${node_version} LTS and its bundled npm..."
if ! command -v node >/dev/null 2>&1 || [[ "$(node --version)" != "v${node_version}" ]]; then
  case "$(uname -m)" in
    x86_64) node_arch=x64 ;;
    aarch64) node_arch=arm64 ;;
    *) echo 'Unsupported orb architecture for Node.js.' >&2; exit 1 ;;
  esac
  archive="node-v${node_version}-linux-${node_arch}.tar.xz"
  download_dir="$(mktemp -d)"
  trap 'rm -rf "$download_dir"' EXIT
  time (
    curl --fail --silent --show-error --retry 3 \
      "https://nodejs.org/dist/v${node_version}/${archive}" -o "$download_dir/$archive"
    curl --fail --silent --show-error --retry 3 \
      "https://nodejs.org/dist/v${node_version}/SHASUMS256.txt" -o "$download_dir/SHASUMS256.txt"
    (cd "$download_dir" && sha256sum --check --ignore-missing SHASUMS256.txt)
    tar --extract --xz --file "$download_dir/$archive" --directory "$download_dir"
    # npm's dependency tree must not be merged with a different bundled version.
    rm -rf /usr/local/lib/node_modules/npm
    # Replace files, not directories; running processes retain the old binary.
    cp --recursive --remove-destination \
      "$download_dir/node-v${node_version}-linux-${node_arch}/." /usr/local/
  )
  rm -rf "$download_dir"
  trap - EXIT
  hash -r
fi
[[ "$(node --version)" == "v${node_version}" ]]
node --version
npm --version

# npm reinstalls even the same global version; reuse the snapshot when it matches.
echo "Preparing Mintlify CLI ${mint_version}..."
if ! command -v mint >/dev/null 2>&1 || [[ "$(mint --version)" != "$mint_version" ]]; then
  time npm install --global --prefer-online --no-audit --no-fund "mint@${mint_version}"
else
  echo 'Pinned Mintlify CLI is already installed.'
fi

# Validation downloads the preview client on a cold orb and reuses it when current.
# Unlike `mint dev`, it terminates and leaves no server running during snapshotting.
echo 'Preparing the preview client and validating the documentation...'
time mint validate
mint version
